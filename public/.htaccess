<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|xml|txt|json)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
# automatisch erzeugt von tools/karten.py (für Apache-Hosting)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.finvallo\.com$ [NC]
RewriteRule ^(.*)$ https://finvallo.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://finvallo.com/$1 [R=301,L]
Redirect 301 /at/kreditkarten/anbieter/ https://finvallo.com/at/kreditkarten/alle/
